# Target network key from config/networks.json: previewnet | shadownet | mainnet
NETWORK=previewnet

# Required ONLY for live deployment / live 5-probe transactions (leave unset for --dry-run / --read-only)
# NEVER commit real private keys. Use dedicated Previewnet test keys funded via https://faucet.previewnet.tezosx.nomadic-labs.com
EVM_PRIVATE_KEY=
TEZOS_SECRET_KEY=

# Optional overrides
EVM_RPC_URL=
MICHELSON_RPC_URL=
OCTEZ_CLIENT_BIN=octez-client
FORGE_BIN=forge
SMARTPY_OUTPUT_DIR=contracts/michelson/artifacts
